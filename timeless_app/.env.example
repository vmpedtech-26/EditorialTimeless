# ── Timeless Editorial · Agente Escritor ──────────────────────────
# Copia este archivo como .env y completa tu API Key de Google AI Studio
# NO subas .env a un repositorio público

GEMINI_API_KEY=pega_tu_api_key_aqui

# Puerto del servidor (por defecto: 3000)
PORT=3000

# Clave pública de Stripe (para el cliente)
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Credenciales de dLocal Go
DLOCAL_LOGIN=tu_x_login_aqui
DLOCAL_TRANS_KEY=tu_x_trans_key_aqui
DLOCAL_SECRET_KEY=tu_secret_key_aqui
DLOCAL_SMARTFIELDS_API_KEY=tu_smartfields_api_key_aqui
DLOCAL_SANDBOX=true

# Secreto maestro para derivar las llaves de cifrado DRM de los capítulos.
# Genera uno propio, por ejemplo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DRM_MASTER_SECRET=genera_tu_propio_secreto_aqui

# ── Producción (Render) ───────────────────────────────────────────
# NODE_ENV=production
# PUBLIC_BASE_URL=https://tu-servicio.onrender.com   (URLs de retorno y webhook de dLocal)
# DLOCAL_SANDBOX=false   ← OBLIGATORIO al usar credenciales reales; sin esto los cobros van a la API sandbox
# FIREBASE_SERVICE_ACCOUNT=<JSON de la cuenta de servicio en una sola línea>

# Atajos SOLO para desarrollo local: webhooks sin firma, checkout simulado y
# mensajes de error detallados. NUNCA definir en producción.
# TIMELESS_DEV=true
