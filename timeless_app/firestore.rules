rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reglas base: denegar acceso por defecto
    match /{document=**} {
      allow read, write: if false;
    }

    // $(...) solo admite una expresión atómica por segmento de ruta,
    // por eso el ID compuesto "gift_<obraId>_<uid>" se arma acá y se
    // interpola como una sola expresión en el exists() de más abajo.
    function giftDocId(obraId) {
      return 'gift_' + obraId + '_' + request.auth.uid;
    }

    // Colección 'users': los usuarios autenticados solo pueden leer su propio documento
    // (La escritura del estado "Premium" la hace el backend mediante firebase-admin)
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Avance de lectura individual
      match /progress/{bookId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Subrayados y notas individuales
      match /highlights/{highlightId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Colección 'obras': borradores que genera el Agente Escritor (función de
    // suscriptores). Antes cualquier cuenta autenticada, incluso gratuita, podía
    // crear documentos sin límite ni forma, lo que permitía llenar la base. Ahora
    // solo crea quien tiene suscripción vigente o pertenece a un Plan Familiar,
    // únicamente con los campos que escribe el Agente y con topes de tamaño.
    function canWriteDrafts() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) && (
        (get(userPath).data.get('isPremium', false) == true &&
          (get(userPath).data.get('premiumUntil', null) == null || get(userPath).data.premiumUntil > request.time)) ||
        get(userPath).data.get('familyId', null) != null
      );
    }
    function validDraft(d) {
      return d.keys().hasOnly(['title', 'genre', 'outline', 'cover', 'chapters', 'userId', 'createdAt', 'bscScore', 'wordCount', 'bscChapters'])
        && d.title is string && d.title.size() <= 300
        && d.chapters is list && d.chapters.size() <= 60;
    }
    match /obras/{obraId} {
      // Un autor puede leer sus obras, o un invitado si reclamó un regalo (gifts/gift_<obra>_<uid>, que solo escribe el servidor)
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        exists(/databases/$(database)/documents/gifts/$(giftDocId(obraId)))
      );
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid
        && canWriteDrafts() && validDraft(request.resource.data);
      allow update: if request.auth != null && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId && validDraft(request.resource.data);
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Colección 'gifts': invitaciones de lectura. Se puede LEER un regalo
    // puntual por su token (el invitado aún sin cuenta ve la invitación antes
    // de reclamarla), pero no listar la colección. Crear y reclamar regalos se
    // hace SOLO desde el servidor (/api/gift/create y /api/gift/claim): antes
    // cualquier usuario autenticado podía escribir acá, fabricarse un regalo
    // "reclamado" y leer obras sin suscripción ni permiso.
    match /gifts/{giftId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }
    
    // Colección 'books': biblioteca para usuarios autenticados de Timeless.
    // Guarda solo metadata + previewChapter (primeros párrafos del cap. 0):
    // la prosa completa NO vive acá — ver 'books_full' más abajo.
    // El catálogo se publica, edita y borra solo desde el servidor
    // (/api/admin/books, restringido al editor con correo verificado y con
    // registro de auditoría), así que ningún navegador escribe acá.
    match /books/{bookId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Colección 'books_full': la prosa completa de cada obra. Nadie la lee ni
    // escribe desde el cliente, ni siquiera el Editor Principal — solo el
    // servidor (Admin SDK, que ignora estas reglas) la toca, desde
    // /api/book/:id/chunk/:index, que sí verifica suscripción premium antes
    // de entregar un capítulo. Separarla de 'books' es lo que impide que
    // cualquier cuenta autenticada (incluida una gratuita) lea capítulos
    // completos con un getDoc/getDocs directo del SDK cliente.
    match /books_full/{bookId} {
      allow read, write: if false;
    }

    // Colección 'families': soporte del Plan Familiar. Solo el titular y sus
    // miembros pueden leerla (para verificar acceso premium compartido); toda
    // escritura se hace desde el backend con firebase-admin, nunca desde el cliente.
    match /families/{familyId} {
      allow read: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.memberIds
      );
      allow write: if false;
    }
  }
}
